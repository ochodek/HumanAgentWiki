<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jarvis.humanagentwiki.mcp</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>HF_HUB_OFFLINE=1</string>
    <string>TRANSFORMERS_OFFLINE=1</string>
    <string>__HAW_PROJECT_DIR__/haw</string>
    <string>serve</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HAW_PROJECT_DIR__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HAW_HOME__/Library/Logs/HumanAgentWiki/mcp.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__HAW_HOME__/Library/Logs/HumanAgentWiki/mcp.stderr.log</string>
</dict>
</plist>
